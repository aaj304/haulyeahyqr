# Copy this file to .env and adjust if needed.
# SQLite database file, created automatically on first `prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Required for POST /api/ingest (machine-to-machine transaction entry from
# an external automation). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave unset to disable that endpoint entirely - the rest of the app works
# fine without it.
INGEST_API_TOKEN=""

# Required for POST /api/sms-webhook (text-a-transaction over SMS, parsed by
# the Claude API). All three below are needed together, or leave all unset
# to disable that endpoint entirely.
#
# From console.anthropic.com - the app's own key for calling the Claude API
# server-side. Costs a small amount per text (well under a cent each).
ANTHROPIC_API_KEY=""
# From the Twilio console (Account > API keys & tokens > Auth Token) - used
# to verify that webhook requests genuinely came from Twilio.
TWILIO_AUTH_TOKEN=""
# This app's own public URL (no trailing slash) - must exactly match what's
# reachable from the internet, since Twilio's signature covers the exact
# webhook URL it POSTed to.
PUBLIC_APP_URL=""
