# Copy this file to .env and adjust if needed.
# SQLite database file, created automatically on first `prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Required for POST /api/ingest (machine-to-machine transaction entry, e.g.
# the iMessage automation). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Leave unset to disable that endpoint entirely - the rest of the app works
# fine without it.
INGEST_API_TOKEN=""
